# Copier en .env (local) ou dans ~/little-cars/shared/.env (serveur).

# URL publique du site : sert aux canonical, au sitemap et aux données structurées.
NEXT_PUBLIC_SITE_URL=https://little-cars.walautao.fr

# "true" uniquement sur little-cars.fr en production. Toute autre valeur
# (préproduction walautao) envoie noindex partout et bloque robots.txt.
SITE_INDEXABLE=false

# Dossier où sont enregistrées les demandes des formulaires (JSON Lines).
DATA_DIR=./data

# Envoi des demandes par e-mail. Sans SMTP_HOST, elles sont seulement enregistrées.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Site Little <no-reply@little-cars.fr>"
MAIL_TO=contact@little-cars.fr
